{
  "name": "instead",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "env:generate": "node --env-file-if-exists=.env scripts/generate-env.mjs",
    "format:check": "prettier --check \"App.tsx\" \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,json,md}\"",
    "icons:generate": "node scripts/generate-icons.mjs",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "postinstall": "npm run env:generate",
    "preandroid": "npm run env:generate",
    "preios": "npm run env:generate",
    "prestart": "npm run env:generate",
    "pretest": "npm run env:generate",
    "pretypecheck": "npm run env:generate",
    "preweb": "npm run env:generate",
    "preweb:build": "npm run env:generate",
    "preweb:test": "npm run env:generate",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
